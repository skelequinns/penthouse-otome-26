# Local dev simulation — Anthropic API key
# Copy this file to .env.local and fill in your key.
# With this set, sending a message in the dev build will call claude-haiku
# and return an actual character response (full beforePrompt → LLM → afterResponse cycle).
# Without it, the dev build falls back to showing stage directions only (debug mode).
#
# NEVER commit .env.local to git.

VITE_ANTHROPIC_API_KEY=sk-ant-...
